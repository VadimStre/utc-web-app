# ============================================================
# Пример файла окружения для локального запуска
# Скопируйте этот файл в .env и при необходимости измените значения
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)
# ============================================================

# Строка подключения к базе данных PostgreSQL.
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД
#
# Вариант 1 — запуск через Docker Compose (рекомендуется):
#   значение ниже уже подходит, менять ничего не нужно.
#
# Вариант 2 — локально установленный PostgreSQL:
#   замените utc_user, utc_password и utc_db на свои значения.
DATABASE_URL="postgresql://utc_user:utc_password@localhost:5432/utc_db?connect_timeout=15"

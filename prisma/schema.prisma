generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  records UTCRecord[]

  @@map("users")
}

model UTCRecord {
  id Int @id @default(autoincrement())

  // 1. Организация, ХК - полное наименование организации
  organization String

  // 2. Передовой продукт организации, ключевой продукт/процесс, превосходящие конкурентов
  keyProduct String

  // 3. Назначение (главная функция) Продукта и объект приложения
  purpose String

  // 4. Категории объектов, в отношении которых может применяться указанная функция
  categories String

  // 5. Принцип действия (используемый физический, химический процесс)
  principle String

  // 6. ПРЕИМУЩЕСТВА, значения Ключевых (отличительных) характеристик
  advantages String

  // 7. Владелец УТК (Организация, должность, контакты) — данные методички, НЕ пользователь системы
  owner String

  // 8. Формулировка УТК
  formulation String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Владелец записи в системе (пользователь, создавший запись). Nullable — записи
  // без ownerId считаются системными/общими: видны всем, редактируются только ADMIN.
  ownerId   String?
  ownerUser User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@map("utc_records")
}

# ============================================================
# Vercel Postgres (Neon/Serverless) — для продакшена
# Заполняется в Vercel Dashboard → Settings → Environment Variables
# НЕ закоммитить настоящие ключи (файл .env уже в .gitignore)
# ============================================================

# Vercel: используй connection string из Neon/Supabase/Vercel Postgres
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# ============================================================
# NextAuth.js — аутентификация
# ============================================================

# Секрет для подписи JWT-сессий NextAuth (обязателен, сгенерируй свой)
NEXTAUTH_SECRET="your-secret-key-here-replace-with-openssl-rand-base64-32"

# URL приложения (без слэша в конце) — для Vercel это https://<project>.vercel.app
NEXTAUTH_URL="https://your-project.vercel.app"

# ============================================================
# Abacus.ai RouteLLM API (AI-мастер, конкуренты, alt-applications)
# ============================================================

ABACUS_API_KEY="your-abacus-api-key-here"
ABACUS_API_BASE_URL="https://routellm.abacus.ai/v1"
ABACUS_MODEL="route-llm"

# ============================================================
# Серверный ключ Serper.dev для веб-поиска конкурентов
# ============================================================

SERPER_API_KEY="your-serper-api-key-here"

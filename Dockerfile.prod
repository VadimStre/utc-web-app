# ---- Продакшен-образ приложения "База данных УТК" ----
FROM node:20-bookworm-slim

# npmjs + retry (npm-пакеты)
RUN npm config set registry https://registry.npmjs.org && \
    npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000

# Зеркало для Prisma-движков (binaries.prisma.sh блокируется в РФ)
ENV PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma
ENV PRISMA_MIGRATION_ENGINE_MIRROR=https://registry.npmmirror.com/-/binary/prisma

RUN apt-get update -y --fix-missing || apt-get update -y --fix-missing; \
    apt-get install -y --no-install-recommends openssl ca-certificates || \
    (sleep 5 && apt-get install -y --no-install-recommends openssl ca-certificates); \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install --legacy-peer-deps || (echo "RETRY npm install..."; npm install --legacy-peer-deps)

# Диагностика: что реально установилось? (вместо слепой гарантии)
RUN echo "=== .bin после npm install ===" && ls -la node_modules/.bin/ 2>/dev/null | grep -E "prisma|tsx" ; \
    echo "=== node_modules/prisma (пакет js) ===" && ls node_modules/prisma/package.json 2>/dev/null && node -e "console.log('prisma pkg version:', require('./node_modules/prisma/package.json').version)" 2>/dev/null ; \
    echo "=== node_modules/@prisma ===" && ls node_modules/@prisma/ 2>/dev/null | head ; \
    echo "=== есть ли бинарник движка ===" && ls -la node_modules/@prisma/engines/ 2>/dev/null | head -20 ; \
    echo "=== prisma CLI (npx prisma --version) ===" && npx --no-install prisma --version 2>&1 | head -5 || echo "npx prisma не запустился"

# Гарантия: prisma обязан быть установлен
RUN test -x node_modules/.bin/prisma && echo "prisma OK: $(node_modules/.bin/prisma --version | head -1)"

COPY . .

RUN ./node_modules/.bin/prisma generate --no-hints

# entrypoint: db push -> seed-if-empty -> build -> start
COPY scripts/docker-entrypoint.prod.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

EXPOSE 3000

CMD ["/app/docker-entrypoint.sh"]

# ---- Продакшен-образ приложения "База данных УТК" ----
FROM node:20-bookworm-slim

# npm-зеркало для РФ (registry.npmjs.org недоступен/медленный из Timeweb)
RUN npm config set registry https://registry.npmmirror.com

RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
# npm ci ненадёжен при --legacy-peer-deps (пропускает prisma/tsx) — используем npm install
RUN npm install --legacy-peer-deps
# Гарантия: prisma и tsx ОБЯЗАТЕЛЬНО установлены
RUN test -x node_modules/.bin/prisma && echo "prisma OK: $(node_modules/.bin/prisma --version | head -1)"

COPY . .

# prisma generate — прямой вызов (без npx, чтобы не качал свежий prisma из сети)
RUN ./node_modules/.bin/prisma generate --no-hints

# entrypoint: db push -> seed-if-empty -> build -> start
COPY scripts/docker-entrypoint.prod.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

EXPOSE 3000

CMD ["/app/docker-entrypoint.sh"]
